generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum ProjectType {
  TAVA_IZMI
  PINUI_BINUI
}

enum ProjectStatus {
  ACTIVE
  FROZEN
  COMPLETED
  CANCELLED
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FROZEN
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING_EXTERNAL
  COMPLETED
  CANCELLED
}

enum UserRole {
  PLANNING_MANAGER
  COORDINATOR
  OPERATIONS
  EXECUTION
  VIEWER
}

enum DelayReason {
  EXTERNAL_FACTOR
  BUDGET_RESOURCES
  INTERNAL_REASON
  OTHER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  tasks     Task[]   @relation("TaskAssignee")
}

model Project {
  id         String        @id @default(cuid())
  name       String
  address    String?
  type       ProjectType
  status     ProjectStatus @default(ACTIVE)
  startDate  DateTime?
  targetDate DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  phases     Phase[]
}

model Phase {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id])
  name       String
  order      Int
  status     PhaseStatus @default(PENDING)
  startDate  DateTime?
  targetDate DateTime?
  endDate    DateTime?
  parallelTo String?
  createdAt  DateTime    @default(now())
  subPhases  SubPhase[]
}

model SubPhase {
  id          String      @id @default(cuid())
  phaseId     String
  phase       Phase       @relation(fields: [phaseId], references: [id])
  name        String
  order       Int
  status      PhaseStatus @default(PENDING)
  isMilestone Boolean     @default(false)
  targetDate  DateTime?
  dependsOn   String?
  createdAt   DateTime    @default(now())
  tasks       Task[]
}

model Task {
  id                String       @id @default(cuid())
  subPhaseId        String
  subPhase          SubPhase     @relation(fields: [subPhaseId], references: [id])
  name              String
  description       String?
  assigneeId        String
  assignee          User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate           DateTime
  status            TaskStatus   @default(OPEN)
  externalParty     String?
  reminderFrequency Int?
  trackingDate      DateTime?
  dependsOnTaskId   String?
  delayReason       DelayReason?
  delayNote         String?
  lastUpdated       DateTime     @updatedAt
  createdAt         DateTime     @default(now())
  notes             String?
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  projectId String?
  date      DateTime
  summary   String?
  createdAt DateTime @default(now())
}
